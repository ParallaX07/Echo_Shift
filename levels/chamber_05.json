  "tutorial_steps": [
    {
      "id": "console",
      "concept": true,
      "title": "A pad with a countdown",
      "explanation": "Pad A stays on for two turns after you step off it, and the gate beside it stays open for as long. Keep walking and you slip through. The far pad has no countdown: it works only while someone stands on it.",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          4
        ]
      }
    },
    {
      "id": "switch-route-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select ROUTE-POWER, then {key:toggle} to switch it on (40 units).",
      "action": "toggle",
      "expected": {
        "pending": [
          "route-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "route-power"
      }
    },
    {
      "id": "apply",
      "objective": "Press {key:apply} to close the console. The route, the gate and the lift have power.",
      "action": "apply",
      "expected": {
        "powered": [
          "route-power"
        ],
        "console": false
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "record",
      "concept": true,
      "title": "Your echo walks it too",
      "explanation": "Record the walk to the far pad. Your echo repeats it on the same countdown, so it passes the gate too, and then it waits on the far pad while you ride the lift.",
      "objective": "Press {key:echo} to start recording.",
      "action": "enter",
      "expected": {
        "phase": "recording",
        "recorded": 0
      },
      "target": {
        "kind": "timeline",
        "index": 0
      }
    },
    {
      "id": "record-pad",
      "objective": "Press {key:move_right} to step onto pad A. Its countdown starts when you leave it.",
      "action": "right",
      "expected": {
