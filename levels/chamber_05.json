  "tutorial_steps": [
    {
      "id": "console",
      "concept": true,
      "title": "A pad with a countdown",
      "explanation": "Pad A stays on for two turns after you step off it, and the gate beside it stays open for as long. Keep walking and you slip through. The far pad has no countdown: it works only while someone stands on it.",
