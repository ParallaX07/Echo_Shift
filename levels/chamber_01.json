  "tutorial_steps": [
    {
      "id": "walk-to-console",
      "concept": true,
      "title": "Your power console",
      "explanation": "You are the amber technician. Reach the elevator to escape. Anything lit is free to walk and spends no turns. The hub where you start is always lit, but the corridors are dark until you power them. The power console is in the hub; {key:console} opens it while you stand on it.",
      "objective": "Press {key:move_left} to walk along the hub to the power console.",
      "action": "left",
      "expected": {
        "player": [
          5,
          5
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          5,
          5
        ]
      }
    },
    {
      "id": "console",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          5,
          5
        ]
      }
    },
    {
      "id": "switch-lift-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select LIFT-POWER, then {key:toggle} to switch it on (20 of 60 power). It lights the corridors and runs the elevator.",
      "action": "toggle",
      "expected": {
        "pending": [
          "lift-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "lift-power"
      }
    },
    {
      "id": "apply",
      "objective": "Press {key:apply} to close the console. The corridors light up: the side rooms hold log terminals if you want to read them.",
      "action": "apply",
      "expected": {
        "powered": [
          "lift-power"
        ],
        "console": false
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "walk-back",
      "objective": "Press {key:move_right} to walk back to the start. A recording starts from where you stand, so start it by the corridor.",
      "action": "right",
      "expected": {
        "player": [
          8,
          5
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          8,
          5
        ]
      }
    },
    {
      "id": "record",
      "concept": true,
      "title": "Recording",
      "explanation": "{key:echo} in the hub starts a recording. Turns only pass while you record or replay, and the elevator only works during a replay. This lesson saves an empty recording just to get moving. A real one comes in chamber 3.",
      "objective": "Press {key:echo} to start recording.",
      "action": "enter",
      "expected": {
        "phase": "recording",
        "recorded": 0
      },
      "target": {
        "kind": "timeline",
        "index": 0
      }
    },
    {
      "id": "commit",
      "objective": "Press {key:echo} again to save the empty recording.",
      "action": "enter",
      "expected": {
        "phase": "committed",
        "recorded": 0,
        "player": [
          8,
          5
        ]
      },
      "target": {
        "kind": "state"
      }
    },
    {
      "id": "launch",
      "objective": "Press {key:echo} at the hub to launch. You start from the entrance with the power still on.",
      "action": "launch",
      "expected": {
        "phase": "replay",
        "player": [
          8,
          5
        ],
        "echo_index": 0
      },
      "target": {
        "kind": "tile",
        "position": [
          8,
          5
        ]
      }
    },
    {
      "id": "corridor",
      "objective": "Press {key:move_right} to follow the lit corridor east.",
      "action": "right",
      "expected": {
