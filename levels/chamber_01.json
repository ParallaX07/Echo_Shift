  "tutorial_steps": [
    {
      "id": "console",
      "concept": true,
      "title": "Your power console",
      "explanation": "You are the amber technician. Reach the elevator to escape. The hub where you start is always lit and safe, but the route is dark until you power it. {key:console} opens the power console.",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          4
        ]
      }
    },
    {
      "id": "switch-lift-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select LIFT-POWER, then {key:toggle} to switch it on (20 of 60 power).",
      "action": "toggle",
      "expected": {
        "pending": [
          "lift-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "lift-power"
      }
    },
    {
      "id": "apply",
      "objective": "Press {key:apply} to close the console. The route and the elevator now have power.",
      "action": "apply",
      "expected": {
        "powered": [
          "lift-power"
        ],
        "console": false
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "record",
      "concept": true,
      "title": "Recording",
      "explanation": "{key:echo} at the hub starts a recording, and you can only walk outside the hub while recording or replaying. This lesson saves an empty recording just to get moving. A real one comes in chamber 3.",
      "objective": "Press {key:echo} to start recording.",
      "action": "enter",
      "expected": {
        "phase": "recording",
        "recorded": 0
      },
      "target": {
        "kind": "timeline",
        "index": 0
      }
    },
    {
      "id": "commit",
      "objective": "Press {key:echo} again to save the empty recording.",
      "action": "enter",
      "expected": {
        "phase": "committed",
        "recorded": 0,
        "player": [
          3,
          4
        ]
      },
      "target": {
        "kind": "state"
      }
    },
    {
      "id": "launch",
      "objective": "Press {key:echo} at the hub to launch. You start from the entrance with the power still on.",
      "action": "launch",
      "expected": {
        "phase": "replay",
        "player": [
          3,
          4
        ],
        "echo_index": 0
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          4
        ]
      }
    },
    {
      "id": "pad-first",
      "objective": "Press {key:move_right} to step onto pad A. Pad A switches the elevator on.",
      "action": "right",
      "expected": {
        "player": [
          4,
          4
        ],
        "active_pad": "pad-a"
      },
      "target": {
        "kind": "tile",
        "position": [
          4,
          4
        ]
      }
    },
    {
      "id": "exit",
      "objective": "Press {key:move_right} to enter the elevator while it is running. Pad A stays on for a few turns after you leave it.",
      "action": "right",
      "expected": {
        "phase": "result",
        "player": [
          5,
          4
        ]
      },
      "target": {
        "kind": "tile",
