  "tutorial_steps": [
    {
      "id": "walk-to-console",
      "concept": true,
      "title": "Your power console",
      "explanation": "You are the amber technician. Reach the elevator to escape. The hub where you start is always lit and safe, but the route is dark until you power it. The power console is in the hub; {key:console} opens it while you stand on it.",
      "objective": "Press {key:move_left} to walk along the hub to the power console.",
      "action": "left",
      "expected": {
        "player": [
          7,
          6
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          7,
          6
        ]
      }
    },
