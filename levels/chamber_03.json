  "hints": [
    "Your echo can stand on the pad while you walk through the gate.",
    "Walk left to the console, switch on LIFT-POWER and walk back to the door. Record one move right and three waits, save with {key:echo}, launch with {key:echo}, then walk right four times."
  ],
  "tutorial_steps": [
    {
      "id": "walk-to-console",
      "concept": true,
      "title": "A pad and a gate",
      "explanation": "This room has a pad that is on only while someone stands on it, and a gate it controls. You cannot hold the pad and walk through the gate at once, so your echo will hold it for you. An echo never supplies power.",
      "objective": "Press {key:move_left} to walk along the hub to the power console.",
      "action": "left",
      "expected": {
        "player": [
          7,
          6
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          7,
          6
        ]
      }
    },
    {
      "id": "console",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          7,
          6
        ]
      }
    },
    {
      "id": "switch-lift-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select LIFT-POWER, then {key:toggle} to switch it on (40 units). It powers the route, the gate and the elevator.",
      "action": "toggle",
      "expected": {
        "pending": [
          "lift-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "lift-power"
      }
    },
    {
      "id": "apply",
      "objective": "Press {key:apply} to close the console. The gate stays shut until pad A is held.",
      "action": "apply",
      "expected": {
        "powered": [
          "lift-power"
        ],
        "console": false
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "walk-back",
      "objective": "Press {key:move_right} to walk back to the entrance. A recording starts from where you stand, so start it at the door.",
      "action": "right",
      "expected": {
        "player": [
          11,
          6
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          11,
          6
        ]
      }
    },
    {
      "id": "record",
      "concept": true,
      "title": "Record your echo",
      "explanation": "{key:echo} at the hub starts a recording. Your echo will repeat each move and wait you make, one per turn. This chamber has 6 slots. {label:retry} ({key:retry}) runs the echo again from launch and {label:rerecord} throws the recording away; both are now in the bottom bar.",
      "objective": "Press {key:echo} to start recording your helper.",
      "action": "enter",
      "expected": {
        "phase": "recording",
        "recorded": 0
      },
      "target": {
        "kind": "timeline",
        "index": 0
      }
    },
    {
      "id": "record-right",
      "objective": "Press {key:move_right} to step onto pad A. This saves a move right in slot 1.",
      "action": "right",
      "expected": {
        "player": [
          12,
          6
        ],
        "recorded": 1,
        "active_pad": "pad-a",
        "open_gate": "gate-a"
      },
      "target": {
        "kind": "tile",
        "position": [
          12,
          6
        ]
      }
    },
    {
