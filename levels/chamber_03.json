  "tutorial_steps": [
    {
      "id": "walk-to-console",
      "concept": true,
      "title": "A pad and a gate",
      "explanation": "The pad in the west corridor is on only while someone stands on it, and the gate in the east corridor is the one it controls. You cannot hold the pad and walk through the gate at once, so your echo will hold it for you. An echo never supplies power.",
      "objective": "Press {key:move_left} to walk along the hub to the power console.",
      "action": "left",
      "expected": {
        "player": [
          6,
          5
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          6,
          5
        ]
      }
    },
    {
      "id": "console",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          6,
          5
        ]
      }
    },
    {
      "id": "switch-lift-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select LIFT-POWER, then {key:toggle} to switch it on (40 units). It lights both corridors and powers the gate and the elevator.",
      "action": "toggle",
      "expected": {
        "pending": [
          "lift-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "lift-power"
      }
    },
    {
      "id": "apply",
      "objective": "Press {key:apply} to close the console. The gate stays shut until pad A is held.",
      "action": "apply",
      "expected": {
        "powered": [
          "lift-power"
        ],
        "console": false
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "record",
      "concept": true,
      "title": "Record your echo",
      "explanation": "{key:echo} at the hub starts a recording from where you stand. Your echo will repeat each move and wait you make, one per turn. This chamber has 6 slots. {label:retry} ({key:retry}) runs the echo again from launch and {label:rerecord} throws the recording away; both are now in the bottom bar.",
      "objective": "Press {key:echo} to start recording your helper.",
      "action": "enter",
      "expected": {
        "phase": "recording",
        "recorded": 0
      },
      "target": {
        "kind": "timeline",
        "index": 0
      }
    },
    {
      "id": "record-corridor",
      "objective": "Press {key:move_left} to walk along the west corridor. Each move is saved in a slot.",
      "action": "left",
      "expected": {
        "player": [
          3,
          5
        ],
        "recorded": 3
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          5
        ]
      }
    },
    {
      "id": "record-pad",
      "objective": "Press {key:move_down} to step onto pad A. Your echo will end its walk here.",
      "action": "down",
      "expected": {
        "player": [
          3,
          6
        ],
        "recorded": 4,
        "active_pad": "pad-a",
        "open_gate": "gate-a"
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          6
        ]
      }
    },
    {
      "id": "wait-one",
      "objective": "Press {key:wait} to save a wait in slot 5. Your echo will stay on pad A that much longer, enough to reach the exit.",
      "action": "wait",
      "expected": {
        "recorded": 5,
        "player": [
          3,
          6
        ]
      },
      "target": {
        "kind": "timeline",
        "index": 4
      }
    },
    {
      "id": "commit",
      "objective": "Press {key:echo} to save the recording. You return to the start and the gate closes.",
      "action": "enter",
      "expected": {
        "phase": "committed",
        "recorded": 5,
        "player": [
          8,
          5
        ]
      },
      "target": {
        "kind": "state"
      }
    },
    {
      "id": "launch",
      "concept": true,
      "title": "Launch your echo",
      "explanation": "Launching resets the room, keeps your power and your recording, and puts your echo at the start. If a run goes wrong, {label:retry} ({key:retry}) starts it again from this moment.",
      "objective": "Press {key:echo} at the hub to launch your echo.",
      "action": "launch",
      "expected": {
        "phase": "replay",
        "echo_index": 0,
        "player": [
          8,
          5
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          8,
          5
        ]
      }
    },
    {
      "id": "replay-walk",
      "objective": "Press {key:move_right} to walk east. Your echo walks west to pad A with every step you take.",
      "action": "right",
      "expected": {
        "player": [
          12,
          5
        ],
        "echo_index": 4,
        "active_pad": "pad-a",
        "open_gate": "gate-a"
      },
      "target": {
        "kind": "tile",
        "position": [
          12,
          5
        ]
      }
    },
    {
      "id": "replay-gate",
      "objective": "Press {key:move_right} to cross the open gate. Your echo waits on pad A and keeps it open.",
      "action": "right",
      "expected": {
        "player": [
          13,
          5
        ],
        "echo_index": 5,
        "open_gate": "gate-a"
      },
      "target": {
        "kind": "tile",
        "position": [
          13,
