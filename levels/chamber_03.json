      "action": "right",
      "expected": {
        "phase": "result",
        "player": [
          14,
          5
        ],
        "echo_index": 5
      },
      "target": {
        "kind": "tile",
        "position": [
          14,
          5
        ]
      }
    }
  ],
  "lesson_summary": "You sent your echo to hold a pad in one corridor while you crossed a gate in another. A machine needs both power and an active pad, and a wait keeps your echo on its pad a turn longer."
