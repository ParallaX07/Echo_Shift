  "tutorial_steps": [
    {
      "id": "console",
      "concept": true,
      "title": "Power has a limit",
      "explanation": "The generator can supply 60 units at once. It is a limit, not a battery that drains. Let's try a setting that is too big, to see what happens.",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          4
        ]
      }
    },
    {
      "id": "switch-path-lights",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select PATH-LIGHTS, then {key:toggle} to switch it on (20 units).",
      "action": "toggle",
      "expected": {
        "pending": [
          "path-lights"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "path-lights"
      }
    },
    {
      "id": "switch-lift-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select LIFT-POWER, then {key:toggle} to switch it on (35 units). That makes 55 of 60.",
      "action": "toggle",
      "expected": {
        "pending": [
          "path-lights",
          "lift-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "lift-power"
      }
    },
    {
      "id": "switch-aux-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select AUX-POWER, then {key:toggle} to switch it on (15 units). That makes 70 of 60.",
      "action": "toggle",
      "expected": {
        "pending": [
          "path-lights",
          "lift-power",
          "aux-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "aux-power"
      }
    },
    {
      "id": "over-budget",
      "concept": true,
      "title": "Over the limit",
      "explanation": "70 is more than the 60-unit limit, so the whole setting is refused. Nothing changes and no turn passes. The game never trims a choice for you.",
      "objective": "Press {key:apply} to try 70 of 60.",
      "action": "apply",
      "expected": {
        "outcome": "rejected",
        "powered": [
          "path-lights",
          "lift-power"
        ],
        "pending": [
          "path-lights",
          "lift-power",
          "aux-power"
        ],
        "console": true
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "remove-aux",
      "objective": "Select AUX-POWER, then press {key:toggle} to switch it off. The route only needs the other two.",
      "action": "toggle",
      "expected": {
        "pending": [
          "path-lights",
          "lift-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "aux-power"
      }
    },
    {
      "id": "apply",
      "objective": "Press {key:apply} to close the console with 55 of 60 in use.",
      "action": "apply",
      "expected": {
        "powered": [
          "path-lights",
          "lift-power"
        ],
        "console": false
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "record",
      "objective": "Press {key:echo} to start recording.",
      "action": "enter",
      "expected": {
        "phase": "recording",
        "recorded": 0
      },
      "target": {
        "kind": "timeline",
        "index": 0
      }
    },
    {
      "id": "commit",
      "objective": "Press {key:echo} again to save the empty recording.",
      "action": "enter",
      "expected": {
        "phase": "committed",
        "recorded": 0,
        "player": [
          3,
          4
        ]
      },
      "target": {
        "kind": "state"
      }
    },
    {
      "id": "launch",
      "objective": "Press {key:echo} at the hub to launch.",
      "action": "launch",
      "expected": {
        "phase": "replay",
        "player": [
          3,
          4
        ],
        "echo_index": 0
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          4
        ]
      }
    },
    {
      "id": "pad",
      "objective": "Press {key:move_right} to step onto pad A. This switches the elevator on.",
      "action": "right",
      "expected": {
        "player": [
          4,
          4
        ],
        "active_pad": "pad-a"
      },
      "target": {
        "kind": "tile",
        "position": [
          4,
          4
        ]
      }
    },
    {
      "id": "floor",
      "objective": "Press {key:move_right} to step onto the lit floor. Pad A stays on while its countdown runs.",
      "action": "right",
      "expected": {
        "player": [
          5,
          4
        ],
        "active_pad": "pad-a"
      },
      "target": {
        "kind": "tile",
        "position": [
          5,
          4
        ]
      }
    },
    {
      "id": "exit",
      "objective": "Press {key:move_right} to reach the elevator before the countdown ends.",
      "action": "right",
      "expected": {
        "phase": "result",
        "player": [
          6,
          4
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          6,
          4
        ]
      }
    }
  ],
  "lesson_summary": "You tested the power limit and chose 55 of 60 units. Power is a limit, not a battery, and a timed pad stays on for a while after you leave it."
