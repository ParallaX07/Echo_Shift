      "position": [
        12,
        4
      ],
      "lines": [
        "Found a mug by the wall, cold and stained blue.",
        "Whoever worked here before me left in a hurry."
      ]
    }
  ],
  "tutorial_steps": [
    {
      "id": "walk-to-console",
      "concept": true,
      "title": "Power has a limit",
      "explanation": "The generator can supply 30 units at once. It is a limit, not a battery that drains. The lift needs more than that, so first let's see what happens when a setting is too big.",
      "objective": "Press {key:move_left} to walk along the hub to the power console.",
      "action": "left",
      "expected": {
        "player": [
          7,
          4
        ]
      },
      "target": {
        "kind": "tile",
        "position": [
          7,
          4
        ]
      }
    },
    {
      "id": "console",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          7,
          4
        ]
      }
    },
    {
      "id": "switch-lift-power",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select LIFT-POWER, then {key:toggle} to switch it on (35 units). That makes 35 of 30.",
      "action": "toggle",
      "expected": {
        "pending": [
          "lift-power"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "lift-power"
      }
    },
    {
      "id": "over-budget",
      "concept": true,
      "title": "Over the limit",
      "explanation": "35 is more than the 30-unit limit, so the whole setting is refused. Nothing changes and no turn passes. The game never trims a choice for you. An energy cell somewhere in the chamber raises the limit.",
      "objective": "Press {key:apply} to try 35 of 30.",
      "action": "apply",
      "expected": {
        "outcome": "rejected",
        "powered": [],
        "pending": [
          "lift-power"
        ],
        "console": true
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "remove-lift",
      "objective": "Select LIFT-POWER, then press {key:toggle} to switch it off again.",
      "action": "toggle",
      "expected": {
        "pending": []
      },
      "target": {
        "kind": "circuit",
        "id": "lift-power"
      }
    },
    {
      "id": "switch-wing-lamp",
      "objective": "Select WING-LAMP, then press {key:toggle} to switch it on (10 of 30 units). It lights the side rooms.",
      "action": "toggle",
      "expected": {
        "pending": [
          "wing-lamp"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "wing-lamp"
      }
    },
    {
      "id": "apply-lamp",
      "objective": "Press {key:apply} to close the console. The side rooms light up.",
      "action": "apply",
      "expected": {
        "powered": [
          "wing-lamp"
        ],
        "console": false
      },
      "target": {
        "kind": "power"
      }
    },
    {
      "id": "walk-west",
      "concept": true,
      "title": "An energy cell",
      "explanation": "The glowing battery in the west room is an energy cell. Walking onto it adds its power to the limit for good, until you restart the chamber. Only walking in the open collects cells, never a recording or a replay.",
      "objective": "Press {key:move_left} to walk west along the lit corridor. Walking lit floor is free.",
      "action": "left",
      "expected": {
