  "tutorial_steps": [
    {
      "id": "console",
      "concept": true,
      "title": "The whole escape",
      "explanation": "Your echo holds a pad in the dark, the generator cannot light the nook and run the machines together, and the pad beside the lift runs on a countdown. Light the nook first, to record the walk.",
      "objective": "Press {key:console} to open the power console.",
      "action": "open_console",
      "expected": {
        "console": true
      },
      "target": {
        "kind": "tile",
        "position": [
          3,
          4
        ]
      }
    },
    {
      "id": "switch-lab-lights",
      "objective": "Press {key:nav_prev} or {key:nav_next} to select LAB-LIGHTS, then {key:toggle} to switch it on (40 units).",
      "action": "toggle",
      "expected": {
        "pending": [
          "lab-lights"
        ]
      },
      "target": {
        "kind": "circuit",
        "id": "lab-lights"
      }
    },
    {
      "id": "apply-lights",
      "objective": "Press {key:apply} to close the console. The nook is lit.",
      "action": "apply",
      "expected": {
